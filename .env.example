# Local setup: see frontend/README.md. Never commit real secrets.
# Reserved Django/Go settings; the current frontend uses config/settings.py
# and does not read these variables or this file automatically.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional in development (random per process); required when DEBUG=false.
DJANGO_SECRET_KEY=
GO_API_BASE_URL=http://127.0.0.1:8080
# Leave empty until the Go health route is agreed and implemented.
GO_API_HEALTH_PATH=
GO_API_TIMEOUT=2

# Для БД:
POSTGRES_USER=edtech_user
POSTGRES_PASSWORD=edtech_password
POSTGRES_DB=edtech_db
POSTGRES_PORT=15432
